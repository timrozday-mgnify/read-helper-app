{
  "name": "ena-read-submission-helper",
  "version": "1.0.0",
  "description": "Native Electron helper for direct ENA read submissions.",
  "author": "ENA Read Submission Helper maintainers",
  "desktopName": "ena-read-submission-helper",
  "homepage": "https://github.com/EBI-Metagenomics/read-helper-app",
  "repository": {
    "type": "git",
    "url": "https://github.com/EBI-Metagenomics/read-helper-app.git"
  },
  "bugs": {
    "url": "https://github.com/EBI-Metagenomics/read-helper-app/issues"
  },
  "main": "dist/main.js",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build && electron .",
    "start": "electron .",
    "test": "vitest run",
    "icons": "node scripts/generate-icons.mjs",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:all": "npm run build && electron-builder -mwl"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "build": {
    "appId": "org.ena.read-submission-helper",
    "productName": "ENA Read Submission Helper",
    "forceCodeSigning": true,
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "icon": "build/icon",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "src/renderer",
        "to": "renderer"
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "notarize": true,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "category": "Utility",
      "maintainer": "ENA Read Submission Helper maintainers",
      "synopsis": "Local ENA read submission helper",
      "description": "Native helper for direct ENA read submissions from a local workstation.",
      "syncDesktopName": true,
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    }
  }
}
